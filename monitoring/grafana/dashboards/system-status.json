    {
      "type": "stat",
      "title": "Backend CPU",
      "description": "CPU used by the backend process (1 = 100% of one core; uvicorn runs one Python process, so ~100% is its ceiling).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
