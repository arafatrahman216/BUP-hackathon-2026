# Copy to .env and fill in. Empty values fall back to the defaults in app/core/config.py.

# ---------- App ----------
APP_NAME=Hackathon API
# development | production | test
APP_ENV=development
# true -> 500 errors include exception details
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins, or * for any.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database ----------
# Local Postgres (the `db` service in docker-compose.yml).
# Inside Docker Compose this is set automatically to ...@db:5432/fuel, so this value is only
# used when you run uvicorn on the host (start the db with `docker compose up -d db`).
# Leave empty to use Supabase Postgres instead (built from the SUPABASE_* values below).
# sqlite+aiosqlite:///./app.db also works for offline work.
DATABASE_URL=postgresql+asyncpg://fuel:fuel@localhost:5432/fuel
DB_ECHO=false
# a query on a dead connection fails after this many seconds instead of hanging
DB_COMMAND_TIMEOUT_SECONDS=10

# ---------- Rate limiting (per client IP, in-memory) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# comma-separated path prefixes to limit
RATE_LIMIT_PATH_PREFIXES=/api/v1/ai

# ---------- AI ----------
# Chain of providers, tried left to right. Repeat an entry to retry it; pin a model
# with provider:model. Examples:
#   gemini,groq,omniroute
#   gemini,gemini,groq
#   gemini:gemini-2.5-flash,groq:llama-3.1-8b-instant
# Providers without credentials are skipped automatically.
AI_PROVIDER_ORDER=gemini,groq,omniroute
# false -> only the FIRST entry above is used (no fallback).
AI_FALLBACK_ENABLED=true
AI_TIMEOUT_SECONDS=60
AI_DEFAULT_TEMPERATURE=0.7
# empty -> provider default
AI_DEFAULT_MAX_TOKENS=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OmniRoute (OpenAI-compatible gateway). Key is optional if your instance doesn't require one.
# Inside Docker, reach an OmniRoute running on your machine via host.docker.internal.
OMNIROUTE_API_KEY=
# a model/combo name configured in OmniRoute; required to enable it
OMNIROUTE_MODEL=
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# ---------- Supabase (storage; database only if DATABASE_URL is empty) ----------
# Project URL from Supabase dashboard -> Project Settings -> API
SUPABASE_URL=
# Database password (Project Settings -> Database)
SUPABASE_PASSWORD=
# service_role key: server-side only, never expose it to the frontend
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=
# Session pooler host (IPv4). The direct host db.<ref>.supabase.co is IPv6-only and
# unreachable from Docker. Find it under Connect -> Session pooler, e.g.
# aws-0-ap-southeast-1.pooler.supabase.com. Empty -> direct connection.
SUPABASE_POOLER_HOST=
MAX_UPLOAD_MB=10

# ---------- Simulator ----------
# The simulator also defaults to port 8000, so run this backend on 8001.
# From inside Docker use http://host.docker.internal:8000
SIMULATOR_BASE_URL=http://localhost:8000
SIMULATOR_TIMEOUT_SECONDS=10
# extra attempts on network errors / 5xx, with exponential backoff
SIMULATOR_RETRIES=2
SIMULATOR_BACKOFF_SECONDS=0.2
# circuit breaker: open after N consecutive failures, retry after the cooldown
SIMULATOR_BREAKER_THRESHOLD=5
SIMULATOR_BREAKER_COOLDOWN_SECONDS=5
# SSE silent this long (seconds) -> reconnect; /v1/instance polling covers the gap
SIMULATOR_STREAM_IDLE_SECONDS=30

# ---------- Pipeline (read -> validate -> save -> detect -> predict -> decide -> explain -> post) ----------
# false -> no background tick watcher
PIPELINE_ENABLED=true
# listen to the simulator's SSE for ticks; /v1/instance is polled as the fallback
PIPELINE_SSE_ENABLED=true
PIPELINE_POLL_SECONDS=1
# demand rate = moving average of the last N ticks
FORECAST_WINDOW_TICKS=8
# risk: cover < transit + URGENT_MARGIN -> urgent; cover < transit + SAFETY -> watch (reorder)
SAFETY_TICKS=8
URGENT_MARGIN_TICKS=2
MIN_SHIPMENT_LITERS=500
DEPOT_RESERVE_LITERS=0
# false -> every recommendation waits for the operator
AUTO_POST_ENABLED=true
# unanswered recommendations expire once older than N ticks AND this many wall-clock seconds
# (so a fast simulator doesn't expire them before the operator can read them)
APPROVAL_TTL_TICKS=48
APPROVAL_MIN_SECONDS=60
# save a world snapshot every N processed ticks
SNAPSHOT_EVERY_TICKS=1

# true -> the dashboard never shows errors: stages fall back to backup/hard-coded data and the
# backend logs "ERROR MASKED ..." with the traceback. Set false to see raw errors while developing.
DEMO_MASK_ERRORS=true

# --- Intelligence (intelligence-plan.md §0.1) ---
PREDICTOR=structural            # structural | moving_average
PLANNER=optimizer               # optimizer (strategic LP + MIP-MPC) | rules; rules is always the fallback
FORECAST_HORIZON_TICKS=24
HISTORY_FETCH_ROWS=1200
PLANNER_TIME_LIMIT_SECONDS=2.0
RATIONING_TRIGGER_DAYS=3.0
MIN_CONFIDENCE_AUTO=0.5
# dynamic approval deadline: auto-approve when one more tick of waiting would lose more than
# DEADLINE_TOLERANCE_TICKS x the station's demand per tick (simulator copy); humans get MIN_REVIEW_SECONDS when free
DEADLINE_TOLERANCE_TICKS=1.0
# tolerance = demand per tick x (DEADLINE_TOLERANCE_TICKS + DEADLINE_CONFIDENCE_SCALE x (1 - confidence))
DEADLINE_CONFIDENCE_SCALE=3.0
MIN_REVIEW_SECONDS=10
ANOMALY_Z=3.0
ANOMALY_CUSUM_K=0.05
ANOMALY_CUSUM_H=0.5
ANOMALY_MIN_LITERS=20
