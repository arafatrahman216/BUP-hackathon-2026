# Copy to `.env` and adjust. Only variables prefixed with VITE_ are exposed to the browser,
# so never put secrets here (they end up in the JS bundle).

# Base URL of the FastAPI backend, including the API prefix. No trailing slash needed.
#   local dev:        http://localhost:8001/api/v1
#   docker compose:   http://localhost:8001/api/v1   (the browser talks to the host port)
#   deployed:         https://api.example.com/api/v1
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Optional: default request timeout in milliseconds (AI calls use a longer one).
# VITE_API_TIMEOUT_MS=30000
